:root {
    --color-text: #243145;
    --color-muted: #657184;
    --color-green: #28b8aa;
    --color-green-dark: #15998e;
    --color-blue: #438fe5;
    --color-sky: #dff4ff;
    --color-yellow: #ffc815;
    --color-yellow-dark: #f1aa00;
    --color-border: #93dcd5;
    --color-card: #ffffff;
    --shadow-card: 0 8px 24px rgba(48, 143, 184, 0.14);
    --radius-card: 10px;
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    color: var(--color-text);
    font-family: "Noto Sans JP", system-ui, sans-serif;
    font-size: 14px;
    font-weight: 700;
    line-height: 1.65;
    background:
        radial-gradient(circle at 9% 18%, rgba(255, 255, 255, 0.85) 0 110px, transparent 111px),
        radial-gradient(circle at 94% 4%, rgba(255, 255, 255, 0.8) 0 140px, transparent 141px),
        linear-gradient(135deg, #d6efff 0%, #eaf8ff 52%, #d9f2ff 100%);
}

a {
    color: inherit;
    text-decoration: none;
}

img {
    display: block;
    max-width: 100%;
}

button {
    font: inherit;
}

.page {
    min-width: 320px;
    padding: 12px 0 18px;
}

.page__inner {
    width: min(1440px, calc(100% - 36px));
    margin: 0 auto;
}

.page__grid {
    display: flex;
    flex-direction: column;
    gap: 6px;
}

.page__column {
    display: contents;
}

.hero {
    order: 1;
}

.concerns {
    order: 2;
}

.reasons {
    order: 3;
}

.lesson-support {
    order: 4;
}

.voices {
    order: 5;
}

.pricing {
    order: 6;
}

.campaign {
    order: 7;
}

.faq {
    order: 8;
}

.section-card {
    position: relative;
    overflow: hidden;
    border-radius: var(--radius-card);
    border: 1px solid rgba(182, 231, 229, 0.48);
    background: rgba(255, 255, 255, 0.96);
    box-shadow: var(--shadow-card);
}

.reasons::before,
.voices::before,
.concerns::before,
.lesson-support::before,
.pricing::before,
.faq::before {
    content: "";
    position: absolute;
    z-index: 0;
    width: 54px;
    height: 36px;
    pointer-events: none;
    background-image: radial-gradient(rgba(67, 143, 229, 0.18) 1.5px, transparent 2px);
    background-size: 9px 9px;
}

.reasons > *,
.voices > *,
.concerns > *,
.lesson-support > *,
.pricing > *,
.faq > * {
    position: relative;
    z-index: 1;
}

.reasons::before {
    left: 20px;
    top: 18px;
}

.voices::before {
    right: 24px;
    top: 18px;
}

.concerns::before {
    left: 24px;
    top: 16px;
}

.lesson-support::before {
    right: 22px;
    top: 18px;
}

.pricing::before {
    left: 22px;
    top: 18px;
}

.faq::before {
    right: 24px;
    top: 16px;
}

.section-heading {
    position: relative;
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin: 0 0 10px;
    color: var(--color-green-dark);
    font-size: 22px;
    font-weight: 900;
    line-height: 1.25;
    text-align: center;
}

.section-heading > span {
    position: relative;
}

.section-heading::before,
.section-heading::after {
    content: "";
    width: 13px;
    height: 9px;
    border-radius: 100% 0 100% 0;
    background: var(--color-green);
    transform: rotate(24deg);
}

.section-heading > span::before,
.section-heading > span::after {
    content: "";
    position: absolute;
    top: 52%;
    width: 8px;
    height: 5px;
    border-radius: 100% 0 100% 0;
    background: rgba(40, 184, 170, 0.72);
}

.section-heading > span::before {
    left: -28px;
    transform: translateY(9px) rotate(-18deg);
}

.section-heading > span::after {
    right: -28px;
    transform: translateY(9px) rotate(38deg);
}

.section-heading__accent {
    color: var(--color-green-dark);
}

.section-heading--small {
    margin-bottom: 12px;
    font-size: 18px;
    color: var(--color-text);
}

.section-heading--small::before,
.section-heading--small::after {
    width: 10px;
    height: 8px;
}

.button {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
    min-height: 50px;
    border-radius: 999px;
    font-size: 18px;
    font-weight: 900;
    letter-spacing: 0;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.button:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 20px rgba(244, 173, 0, 0.24);
}

.button--primary {
    min-width: 334px;
    padding: 0 52px 0 38px;
    color: #1b240f;
    background: linear-gradient(180deg, #ffd633 0%, var(--color-yellow) 100%);
    box-shadow: inset 0 -3px 0 rgba(213, 151, 0, 0.35), 0 8px 18px rgba(255, 198, 21, 0.32);
}

.button__arrow {
    position: absolute;
    right: 24px;
    width: 12px;
    height: 12px;
    border-top: 3px solid #233046;
    border-right: 3px solid #233046;
    transform: rotate(45deg);
}

.site-header {
    position: relative;
    z-index: 5;
    display: flex;
    align-items: center;
    gap: 12px;
    min-height: 43px;
    padding: 0 14px;
    background: rgba(255, 255, 255, 0.82);
    backdrop-filter: blur(8px);
    transition: box-shadow 0.2s ease, background 0.2s ease;
}

.site-header.is-scrolled {
    background: rgba(255, 255, 255, 0.96);
    box-shadow: 0 6px 18px rgba(52, 150, 190, 0.14);
}

.site-header__brand {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    min-width: max-content;
}

.site-header__mark {
    position: relative;
    width: 30px;
    height: 28px;
    border-radius: 54% 54% 54% 12%;
    background: linear-gradient(135deg, #8bd8cf, #33b7a9);
}

.site-header__mark::after {
    content: "";
    position: absolute;
    right: -5px;
    bottom: 2px;
    border-top: 7px solid transparent;
    border-bottom: 2px solid transparent;
    border-left: 10px solid #33b7a9;
    transform: rotate(26deg);
}

.site-header__text {
    display: grid;
    line-height: 1.15;
}

.site-header__name {
    font-size: 15px;
    font-weight: 900;
}

.site-header__note {
    margin-top: 2px;
    font-size: 8px;
    color: var(--color-muted);
}

.site-header__nav {
    display: flex;
    justify-content: center;
    gap: 15px;
    flex: 1;
    font-size: 10px;
    color: #38455a;
}

.site-header__link {
    white-space: nowrap;
}

.site-header__actions {
    display: flex;
    align-items: center;
    gap: 6px;
    white-space: nowrap;
}

.site-header__login,
.site-header__trial {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 32px;
    border-radius: 999px;
    padding: 0 12px;
    font-size: 11px;
    font-weight: 900;
}

.site-header__login {
    color: var(--color-green-dark);
    border: 1px solid var(--color-green);
    background: #fff;
}

.site-header__trial {
    color: #17220d;
    background: var(--color-yellow);
}

.site-header__menu {
    display: none;
    place-items: center;
    gap: 5px;
    width: 36px;
    height: 32px;
    padding: 0;
    color: #1474c9;
    border: 0;
    background: transparent;
    cursor: pointer;
}

.site-header__menu span {
    display: block;
    width: 26px;
    height: 3px;
    border-radius: 999px;
    background: currentColor;
}

.hero {
    min-height: 0;
}

.hero__body {
    position: relative;
    min-height: clamp(382px, 28vw, 430px);
    padding: 38px 44px 20px;
    background: url("../img/hero_shape_bg.png") left center / cover no-repeat;
}

.hero__image {
    position: absolute;
    z-index: 0;
    inset: 0 0 auto auto;
    width: 68%;
    height: clamp(382px, 28vw, 430px);
    object-fit: cover;
    object-position: 63% center;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.92) 18%, #000 34%);
    mask-image: linear-gradient(to right, transparent 0%, rgba(0, 0, 0, 0.92) 18%, #000 34%);
}

.hero__content {
    position: relative;
    z-index: 2;
    width: 50%;
    padding-left: 76px;
}

.hero__eyebrow {
    display: inline-flex;
    align-items: center;
    margin: 0 0 12px 34px;
    padding: 6px 32px;
    color: var(--color-text);
    font-size: 13px;
    border: 2px solid var(--color-green);
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.94);
}

.hero__eyebrow::after {
    content: "";
    width: 14px;
    height: 10px;
    margin-left: 8px;
    border-radius: 100% 0 100% 0;
    background: var(--color-green);
    transform: rotate(22deg);
}

.hero__title {
    margin: 0 0 12px;
    font-size: clamp(44px, 4vw, 52px);
    font-weight: 900;
    line-height: 1.13;
    letter-spacing: 0;
}

.hero__title-line {
    display: block;
    white-space: nowrap;
}

.hero__title-line--green {
    color: var(--color-green);
}

.hero__title-line--blue {
    color: var(--color-blue);
}

.hero__lead {
    width: min(355px, 100%);
    margin: 0;
    font-size: 12px;
    color: #2f3a4f;
    line-height: 1.8;
}

.hero__count {
    position: absolute;
    z-index: 3;
    right: 64px;
    top: 64px;
    display: grid;
    place-items: center;
    width: 118px;
    height: 118px;
    color: var(--color-green-dark);
    text-align: center;
    border-radius: 50%;
    background: rgba(255, 255, 255, 0.94);
    box-shadow: 0 4px 16px rgba(80, 168, 189, 0.14);
}

.hero__crown {
    font-size: 17px;
    line-height: 1;
}

.hero__count-label {
    margin-top: -6px;
    font-size: 10px;
}

.hero__count-number {
    margin-top: -5px;
    font-size: 24px;
    line-height: 1;
}

.hero__count-text {
    margin-top: -4px;
    font-size: 18px;
    font-weight: 900;
}

.hero__bottom {
    position: relative;
    z-index: 6;
    display: grid;
    justify-items: center;
    margin-top: -18px;
    padding: 0 0 18px;
}

.hero__features {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    width: min(520px, calc(100% - 84px));
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    border: 1px solid var(--color-border);
    border-radius: 18px;
    background: rgba(255, 255, 255, 0.92);
    box-shadow: 0 5px 16px rgba(51, 169, 185, 0.11);
}

.hero__feature {
    display: flex;
    align-items: center;
    gap: 9px;
    min-height: 52px;
    padding: 8px 14px;
    color: #2a4659;
    font-size: 11px;
    line-height: 1.35;
}

.hero__feature + .hero__feature {
    border-left: 1px solid #d6ecea;
}

.hero__feature--reserve {
    display: none;
}

.hero__cta-wrap {
    position: relative;
    display: grid;
    justify-items: center;
    margin-left: 0;
}

.hero__limited {
    position: absolute;
    left: -20px;
    top: -14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 63px;
    height: 38px;
    color: #fff;
    font-size: 13px;
    border-radius: 50%;
    background: var(--color-green);
    transform: rotate(-8deg);
}

.hero__cta-note {
    margin: 0 0 2px;
    font-size: 13px;
}

.line-icon {
    position: relative;
    display: inline-flex;
    flex: 0 0 auto;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    color: var(--color-green);
    border: 2px solid var(--color-green);
    border-radius: 10px;
}

.line-icon::before,
.line-icon::after {
    content: "";
    position: absolute;
}

.line-icon--book::before {
    width: 18px;
    height: 14px;
    border: 2px solid currentColor;
    border-radius: 2px;
}

.line-icon--book::after {
    width: 2px;
    height: 16px;
    background: currentColor;
}

.line-icon--screen::before {
    width: 20px;
    height: 13px;
    border: 2px solid currentColor;
    border-radius: 2px;
}

.line-icon--screen::after {
    bottom: 6px;
    width: 14px;
    height: 2px;
    background: currentColor;
}

.line-icon--support {
    border-radius: 50%;
}

.line-icon--support::before {
    top: 8px;
    width: 14px;
    height: 11px;
    border: 2px solid currentColor;
    border-bottom: 0;
    border-radius: 10px 10px 0 0;
}

.line-icon--support::after {
    bottom: 7px;
    width: 16px;
    height: 7px;
    border: 2px solid currentColor;
    border-radius: 50% 50% 45% 45%;
}

.line-icon--teacher {
    border-radius: 50%;
}

.line-icon--teacher::before {
    top: 7px;
    width: 12px;
    height: 12px;
    border: 2px solid currentColor;
    border-radius: 50%;
}

.line-icon--teacher::after {
    bottom: 5px;
    width: 19px;
    height: 10px;
    border: 2px solid currentColor;
    border-radius: 12px 12px 4px 4px;
}

.line-icon--calendar::before {
    width: 20px;
    height: 18px;
    border: 2px solid currentColor;
    border-radius: 3px;
}

.line-icon--calendar::after {
    top: 12px;
    width: 20px;
    height: 2px;
    background: currentColor;
}

.line-icon--gift::before {
    width: 20px;
    height: 16px;
    border: 2px solid currentColor;
    border-radius: 3px;
}

.line-icon--gift::after {
    width: 2px;
    height: 20px;
    background: currentColor;
}

.reasons {
    padding: 14px 18px 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(252, 255, 255, 0.96));
}

.reasons__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.reason-card {
    min-height: 84px;
    padding: 14px 15px 12px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: #fcffff;
}

.reason-card .line-icon {
    float: left;
    margin-right: 10px;
}

.reason-card__title {
    margin: 2px 0 7px;
    color: var(--color-green-dark);
    font-size: 14px;
    font-weight: 900;
}

.reason-card__text {
    clear: both;
    margin: 0;
    font-size: 12px;
    font-weight: 700;
    line-height: 1.7;
}

.voices {
    padding: 14px 18px 8px;
}

.voices__swiper {
    padding: 0 0 18px;
}

.voice-card {
    display: grid;
    grid-template-columns: 112px 1fr;
    gap: 18px;
    min-height: 146px;
    padding: 16px;
    border: 1px solid #d6e5e7;
    border-radius: 9px;
    background: #fff;
}

.voice-card__photo {
    width: 108px;
    height: 108px;
    border-radius: 18px;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
}

.voice-card__photo--one {
    background-image: url("../img/voice_1.png");
}

.voice-card__photo--two {
    background-image: url("../img/voice_2.png");
}

.voice-card__photo--three {
    background-image: url("../img/voice_3.png");
}

.voice-card__title {
    margin: 0 0 6px;
    color: #233046;
    font-size: 15px;
    font-weight: 900;
    line-height: 1.45;
}

.voice-card__text {
    margin: 0 0 8px;
    font-size: 12px;
    line-height: 1.7;
}

.voice-card__name {
    margin: 0;
    font-size: 10px;
    text-align: right;
}

.voices__pagination {
    display: none;
}

.voices__caption {
    margin: -6px 8px 0 0;
    color: #687889;
    font-size: 10px;
    text-align: right;
}

.campaign {
    min-height: 174px;
    padding: 18px 24px 14px;
    background:
        linear-gradient(90deg, rgba(255, 255, 255, 0.96) 0%, rgba(255, 255, 255, 0.9) 57%, rgba(255, 255, 255, 0.24) 100%),
        #fff;
}

.campaign__image {
    position: absolute;
    inset: 0 0 0 auto;
    width: 32%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scaleX(-1);
    transform-origin: center;
    -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 22%);
    mask-image: linear-gradient(to right, transparent 0%, #000 22%);
}

.campaign__flags {
    position: absolute;
    top: 0;
    left: 18px;
    right: 16px;
    display: flex;
    justify-content: space-between;
    opacity: 0.55;
}

.campaign__flags::before {
    content: "";
    position: absolute;
    left: 8px;
    right: 8px;
    top: 0;
    border-top: 1px solid rgba(40, 184, 170, 0.32);
}

.campaign__flags span {
    position: relative;
    width: 0;
    height: 0;
    border-left: 14px solid transparent;
    border-right: 14px solid transparent;
    border-top: 20px solid #a9dfd7;
}

.campaign__flags span:nth-child(2n) {
    border-top-color: #ffe18a;
    transform: translateY(-1px) rotate(3deg);
}

.campaign__flags span:nth-child(2n + 1) {
    transform: rotate(-4deg);
}

.campaign__content {
    position: relative;
    z-index: 2;
    display: grid;
    justify-items: center;
    width: 76%;
}

.campaign__tag {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 110px;
    min-height: 28px;
    margin: 0 0 6px;
    color: #fff;
    font-size: 12px;
    border-radius: 999px;
    background: var(--color-green);
}

.campaign__title {
    margin: 0 0 12px;
    color: var(--color-green-dark);
    font-size: 28px;
    font-weight: 900;
    line-height: 1.25;
}

.campaign__points {
    display: grid;
    grid-template-columns: repeat(3, max-content);
    justify-content: center;
    gap: 34px;
    width: 100%;
    margin: 0 0 12px;
    padding: 0;
    list-style: none;
    color: #2f495c;
    font-size: 13px;
    text-align: center;
}

.campaign__points li {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding-left: 0;
    white-space: nowrap;
}

.campaign__points li::before {
    content: "✓";
    position: static;
    flex: 0 0 auto;
    display: inline-grid;
    place-items: center;
    width: 20px;
    height: 20px;
    color: var(--color-green-dark);
    border: 2px solid var(--color-green);
    border-radius: 50%;
}

.campaign__button {
    min-height: 46px;
    min-width: 390px;
    font-size: 17px;
}

.campaign__note {
    margin: 4px 0 0;
    font-size: 11px;
}

.concerns {
    padding: 14px 20px 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(250, 255, 255, 0.96));
}

.concerns .section-heading {
    color: var(--color-text);
}

.concerns .section-heading > span {
    font-weight: 900;
}

.concerns .section-heading > span {
    color: var(--color-text);
}

.concerns .section-heading__accent {
    color: var(--color-green-dark);
}

.concerns__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
    max-width: 1120px;
    margin: 0 auto;
}

.concern-card {
    display: grid;
    grid-template-rows: auto 1fr;
    min-height: 170px;
    padding: 12px 12px 9px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: #fff;
}

.concern-card__title {
    min-height: 50px;
    margin: 0;
    color: #1f2d3f;
    font-size: 12px;
    font-weight: 900;
    line-height: 1.55;
    text-align: center;
}

.concern-card__image {
    align-self: end;
    width: 100%;
    height: 102px;
    background-repeat: no-repeat;
    background-size: contain;
    background-position: center bottom;
}

.concern-card__image--one {
    background-image: url("../img/concern_1.png");
}

.concern-card__image--two {
    background-image: url("../img/concern_2.png");
}

.concern-card__image--three {
    background-image: url("../img/concern_3.png");
}

.concern-card__image--four {
    background-image: url("../img/concern_4.png");
}

.concerns__lead {
    margin: 10px 0 0;
    color: #374155;
    font-size: 13px;
    line-height: 1.7;
    text-align: center;
}

.concerns__lead strong {
    color: var(--color-green-dark);
}

.lesson-support {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: 24px;
    padding: 16px 18px 14px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(252, 255, 255, 0.96));
}

.lesson-list {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 9px;
}

.lesson-card {
    position: relative;
    display: grid;
    align-content: start;
    min-height: 218px;
    padding: 12px 10px 10px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: #f7ffff;
    text-align: center;
}

.lesson-card--responsive {
    display: none;
}

.lesson-card__level {
    position: relative;
    z-index: 2;
    left: auto;
    top: auto;
    order: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    min-width: 70px;
    min-height: 20px;
    margin-bottom: 7px;
    padding: 0 9px;
    color: #fff;
    font-size: 10px;
    border-radius: 999px;
    transform: none;
}

.lesson-card__level--green {
    background: var(--color-green);
}

.lesson-card__level--blue {
    background: var(--color-blue);
}

.lesson-card__image {
    order: 3;
    height: 122px;
    margin: 0 0 6px;
    border-radius: 7px;
    background-repeat: no-repeat;
    background-size: auto 180px;
    background-position: center 52%;
}

.lesson-card__image--one {
    background-image: url("../img/lesson_1.png");
}

.lesson-card__image--two {
    background-image: url("../img/lesson_2.png");
}

.lesson-card__image--three {
    background-image: url("../img/lesson_3.png");
}

.lesson-card__image--four {
    background-image: url("../img/lesson_2.png");
}

.lesson-card__title {
    position: relative;
    left: auto;
    right: auto;
    top: auto;
    order: 2;
    margin: 0 0 7px;
    color: #16283a;
    font-size: 13px;
    font-weight: 900;
    line-height: 1.45;
    text-shadow: 0 1px 0 #fff;
}

.lesson-card__text {
    order: 4;
    margin: 0;
    font-size: 10px;
    line-height: 1.6;
}

.lesson-support__caption {
    margin: 6px 0 0;
    color: #7a8792;
    font-size: 9px;
    text-align: center;
}

.support-list {
    display: grid;
    gap: 11px;
}

.support-item {
    display: grid;
    grid-template-columns: 42px 1fr 116px;
    gap: 10px;
    align-items: center;
    min-height: 70px;
}

.support-item__title {
    margin: 0 0 2px;
    color: var(--color-green-dark);
    font-size: 14px;
    font-weight: 900;
}

.support-item__text {
    margin: 0;
    color: #485668;
    font-size: 11px;
    line-height: 1.5;
}

.support-item__photo {
    width: 116px;
    height: 78px;
    border-radius: 8px;
    background-repeat: no-repeat;
    background-size: cover;
    background-position: center;
    box-shadow: 0 3px 10px rgba(50, 140, 170, 0.14);
}

.support-item__photo--one {
    background-image: url("../img/support_1.png");
}

.support-item__photo--two {
    background-image: url("../img/support_2.png");
}

.support-item__photo--three {
    background-image: url("../img/support_3.png");
}

.pricing {
    padding: 14px 18px 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(252, 255, 255, 0.96));
}

.pricing .section-heading {
    color: var(--color-text);
}

.pricing__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr) 1.03fr;
    gap: 12px;
}

.price-card,
.included-box {
    position: relative;
    min-height: 174px;
    padding: 13px 13px 10px;
    border: 1px solid var(--color-border);
    border-radius: 9px;
    background: #fff;
    text-align: center;
}

.price-card--featured {
    border: 2px solid var(--color-blue);
    box-shadow: 0 10px 22px rgba(67, 143, 229, 0.14);
}

.price-card__badge {
    position: absolute;
    top: -14px;
    left: -6px;
    padding: 4px 14px;
    color: #fff;
    font-size: 10px;
    border-radius: 999px 999px 999px 2px;
    background: var(--color-blue);
}

.price-card__name {
    margin: 0;
    color: var(--color-green-dark);
    font-size: 17px;
    font-weight: 900;
}

.price-card--featured .price-card__name,
.price-card--featured .price-card__price {
    color: var(--color-blue);
}

.price-card__catch {
    margin: 2px 0 1px;
    color: var(--color-green-dark);
    font-size: 11px;
}

.price-card__price {
    margin: 0;
    color: var(--color-green-dark);
    line-height: 1.05;
    white-space: nowrap;
}

.price-card__price strong {
    font-size: 32px;
    font-weight: 900;
}

.price-card__price span {
    margin-left: 2px;
    font-size: 16px;
    font-weight: 900;
}

.price-card__detail {
    margin: 3px 0;
    color: #20645f;
    font-size: 11px;
}

.price-card__per {
    display: inline-flex;
    margin: 0 0 5px;
    padding: 2px 9px;
    color: #fff;
    font-size: 11px;
    border-radius: 999px;
    background: var(--color-green);
}

.price-card--featured .price-card__per {
    background: var(--color-blue);
}

.price-card__features,
.included-box__list {
    display: grid;
    gap: 4px;
    margin: 0;
    padding: 0;
    list-style: none;
    text-align: left;
}

.price-card__features li {
    position: relative;
    padding-left: 16px;
    font-size: 11px;
    line-height: 1.45;
}

.price-card__features li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--color-green-dark);
}

.included-box {
    background: #f4fcfb;
}

.included-box__title {
    margin: 0 0 8px;
    color: var(--color-green-dark);
    font-size: 14px;
    font-weight: 900;
    line-height: 1.45;
}

.included-box__list {
    gap: 10px;
}

.included-box__list li {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 12px;
}

.included-box__list .line-icon {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-radius: 7px;
}

.included-box__list .line-icon::before {
    transform: scale(0.68);
}

.included-box__list .line-icon::after {
    transform: scale(0.68);
}

.pricing__note {
    margin: 9px 8px 0 0;
    color: #7a8792;
    font-size: 10px;
    text-align: right;
}

.faq {
    padding: 14px 18px 12px;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.98), rgba(252, 255, 255, 0.96));
}

.faq .section-heading {
    color: var(--color-text);
}

.faq__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 160px;
    gap: 12px;
    align-items: end;
}

.faq__list {
    display: grid;
    gap: 6px;
}

.faq__item {
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: #fff;
    transition: border-radius 0.2s ease, box-shadow 0.2s ease;
}

.faq__item.is-open {
    border-radius: 17px;
    box-shadow: 0 4px 12px rgba(51, 169, 185, 0.09);
}

.faq__question {
    display: grid;
    grid-template-columns: 24px 1fr 16px;
    gap: 8px;
    align-items: center;
    width: 100%;
    min-height: 32px;
    padding: 4px 12px 4px 10px;
    color: #233046;
    text-align: left;
    border: 0;
    background: transparent;
    cursor: pointer;
}

.faq__mark {
    display: inline-grid;
    place-items: center;
    width: 22px;
    height: 22px;
    color: #fff;
    font-size: 12px;
    border-radius: 50%;
    background: var(--color-green);
}

.faq__question span:nth-child(2) {
    font-size: 11px;
    font-weight: 900;
}

.faq__toggle {
    position: relative;
    width: 12px;
    height: 12px;
}

.faq__toggle::before,
.faq__toggle::after {
    content: "";
    position: absolute;
    left: 1px;
    top: 5px;
    width: 10px;
    height: 2px;
    background: var(--color-green);
}

.faq__toggle::after {
    transform: rotate(90deg);
    transition: transform 0.2s ease;
}

.faq__item.is-open .faq__toggle::after {
    transform: rotate(0deg);
}

.faq__answer {
    display: none;
    padding: 0 42px 9px;
}

.faq__item.is-open .faq__answer {
    display: block;
}

.faq__answer p {
    margin: 0;
    color: #617083;
    font-size: 10px;
    line-height: 1.5;
}

.faq__helper {
    position: relative;
    min-height: 190px;
}

.faq__bubble {
    position: absolute;
    right: 36px;
    top: 0;
    display: grid;
    place-items: center;
    width: 55px;
    height: 45px;
    color: var(--color-green-dark);
    font-size: 18px;
    font-weight: 900;
    border: 2px solid var(--color-green);
    border-radius: 50%;
    background: #fff;
}

.faq__bubble::after {
    content: "";
    position: absolute;
    right: 10px;
    bottom: -8px;
    width: 12px;
    height: 12px;
    border-right: 2px solid var(--color-green);
    border-bottom: 2px solid var(--color-green);
    background: #fff;
    transform: rotate(38deg);
}

.faq__image {
    position: absolute;
    right: 0;
    bottom: -12px;
    width: 148px;
    height: 154px;
    object-fit: cover;
    object-position: center top;
}

.footer {
    display: grid;
    grid-template-columns: 1fr 1.65fr 1.2fr;
    gap: 18px;
    align-items: center;
    margin-top: 6px;
    padding: 12px 20px;
}

.footer__copy {
    width: min(250px, 100%);
    margin: 8px 0 0;
    color: #4d5a6b;
    font-size: 11px;
    line-height: 1.55;
}

.footer__nav {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 12px;
}

.footer__group {
    display: grid;
    gap: 2px;
    color: #334257;
    font-size: 10px;
}

.footer__heading {
    margin: 0 0 2px;
    font-size: 11px;
    font-weight: 900;
}

.footer__action {
    display: grid;
    justify-items: end;
    gap: 7px;
}

.footer__socials {
    display: flex;
    gap: 10px;
    justify-content: flex-end;
}

.footer__social {
    display: grid;
    place-items: center;
    width: 23px;
    height: 23px;
    color: #fff;
    font-size: 12px;
    border-radius: 50%;
}

.footer__social--line {
    background: #00c300;
}

.footer__social--instagram {
    background: linear-gradient(135deg, #ffcb52, #ee3f80 50%, #6a5cff);
}

.footer__social--twitter {
    background: #4ea4ee;
}

.footer__social--facebook {
    background: #4169a9;
}

.footer__button {
    min-width: 300px;
    min-height: 40px;
    font-size: 14px;
}

@media (min-width: 961px) {
    .voices .swiper-wrapper {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 12px;
        transform: none;
    }

    .voices .swiper-slide {
        width: auto;
    }
}

@media (max-width: 1180px) {
    .page__grid {
        grid-template-columns: 1fr;
    }

    .site-header {
        flex-wrap: wrap;
        justify-content: center;
        padding: 10px 16px;
    }

    .site-header__nav {
        order: 3;
        flex-basis: 100%;
        flex-wrap: wrap;
        gap: 12px 22px;
    }
}

@media (max-width: 960px) {
    .page__inner {
        width: calc(100% - 20px);
    }

    .section-heading {
        margin-bottom: 9px;
        font-size: 18px;
    }

    .section-heading--small {
        font-size: 17px;
    }

    .site-header {
        flex-wrap: nowrap;
        justify-content: space-between;
        min-height: 48px;
        padding: 0 16px;
    }

    .site-header__nav {
        position: absolute;
        left: 14px;
        right: 14px;
        top: calc(100% + 6px);
        order: initial;
        z-index: 20;
        display: none;
        grid-template-columns: repeat(3, 1fr);
        flex-basis: auto;
        gap: 8px;
        padding: 12px;
        border: 1px solid rgba(147, 220, 213, 0.72);
        border-radius: 9px;
        background: rgba(255, 255, 255, 0.98);
        box-shadow: 0 10px 24px rgba(48, 143, 184, 0.16);
    }

    .site-header.is-menu-open .site-header__nav {
        display: grid;
    }

    .site-header__actions {
        margin-left: auto;
    }

    .site-header__login {
        display: none;
    }

    .site-header__trial {
        min-height: 30px;
        padding: 0 18px;
        font-size: 10px;
    }

    .site-header__menu {
        display: grid;
    }

    .hero {
        position: relative;
    }

    .hero__body {
        min-height: 306px;
        padding: 26px 30px 58px;
    }

    .footer {
        grid-template-columns: 0.9fr 1.65fr auto;
        gap: 12px;
        padding: 10px 16px;
    }

    .hero__image {
        opacity: 1;
        width: 54%;
        height: 306px;
        inset: 0 -16px auto auto;
        object-position: 62% center;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 22%, rgba(0, 0, 0, 0.82) 38%, #000 56%);
        mask-image: linear-gradient(to right, transparent 0%, transparent 22%, rgba(0, 0, 0, 0.82) 38%, #000 56%);
    }

    .hero__content {
        width: 54%;
        padding-left: 10px;
    }

    .hero__eyebrow {
        margin: 0 0 8px;
        padding: 4px 24px;
        font-size: 11px;
    }

    .hero__title {
        margin-bottom: 8px;
        font-size: 39px;
        line-height: 1.12;
    }

    .hero__lead {
        width: min(300px, 100%);
        font-size: 10px;
        line-height: 1.65;
    }

    .hero__count {
        right: 24px;
        top: 74px;
        width: 100px;
        height: 100px;
    }

    .hero__count-number {
        font-size: 20px;
    }

    .hero__count-text {
        font-size: 15px;
    }

    .hero__bottom {
        display: grid;
        justify-items: center;
        margin-top: 0;
        padding: 0;
    }

    .hero__features {
        order: 2;
        grid-template-columns: repeat(4, 1fr);
        width: 100%;
        margin: 0;
        border-right: 0;
        border-left: 0;
        border-radius: 0;
        box-shadow: none;
    }

    .hero__feature {
        justify-content: center;
        min-height: 54px;
        padding: 7px 10px;
        font-size: 10px;
    }

    .hero__feature--reserve {
        display: flex;
    }

    .hero__cta-wrap {
        position: relative;
        left: auto;
        bottom: auto;
        z-index: 8;
        order: 1;
        margin: -54px 0 12px;
    }

    .hero__limited,
    .hero__cta-note {
        display: none;
    }

    .hero__cta-wrap .button--primary {
        min-width: 300px;
        min-height: 38px;
        padding-left: 26px;
        padding-right: 46px;
        font-size: 13px;
    }

    .reasons,
    .voices,
    .campaign,
    .concerns,
    .lesson-support,
    .pricing,
    .faq {
        padding: 12px 14px;
    }

    .reasons__grid,
    .concerns__grid {
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }

    .reason-card {
        min-height: 78px;
        padding: 10px 9px 9px;
    }

    .reason-card .line-icon {
        width: 28px;
        height: 28px;
        margin-right: 7px;
    }

    .reason-card__title {
        margin-bottom: 4px;
        font-size: 11px;
    }

    .reason-card__text {
        font-size: 10px;
        line-height: 1.55;
    }

    .concern-card {
        min-height: 134px;
        padding: 10px 8px 6px;
    }

    .concern-card__title {
        min-height: 44px;
        font-size: 10px;
        line-height: 1.45;
    }

    .concern-card__image {
        height: 72px;
    }

    .concerns__lead {
        margin-top: 8px;
        font-size: 11px;
        line-height: 1.55;
    }

    .lesson-support {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .lesson-list {
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
        counter-reset: lesson-step;
    }

    .lesson-card {
        min-height: 120px;
        padding: 10px 8px 8px;
        counter-increment: lesson-step;
    }

    .lesson-card--responsive {
        display: grid;
    }

    .lesson-card::before {
        content: counter(lesson-step);
        position: absolute;
        left: 8px;
        top: 8px;
        display: grid;
        place-items: center;
        width: 18px;
        height: 18px;
        color: #fff;
        font-size: 10px;
        border-radius: 50%;
        background: var(--color-green-dark);
    }

    .lesson-card:not(:last-child)::after {
        content: "";
        position: absolute;
        right: -8px;
        top: 54px;
        z-index: 2;
        width: 9px;
        height: 9px;
        border-top: 3px solid var(--color-blue);
        border-right: 3px solid var(--color-blue);
        transform: rotate(45deg);
    }

    .lesson-card__level {
        display: none;
    }

    .lesson-card__title {
        order: 1;
        margin-bottom: 4px;
        padding-left: 10px;
        font-size: 11px;
        line-height: 1.35;
    }

    .lesson-card__image {
        order: 2;
        height: 58px;
        margin: 0 0 4px;
        background-size: auto 90px;
    }

    .lesson-card__text {
        font-size: 9px;
        line-height: 1.45;
    }

    .lesson-support__support {
        position: relative;
        min-height: 142px;
        padding-right: 206px;
    }

    .support-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px 16px;
    }

    .support-item {
        grid-template-columns: 30px 1fr;
        gap: 8px;
        min-height: 46px;
    }

    .support-item .line-icon {
        width: 30px;
        height: 30px;
    }

    .support-item__title {
        font-size: 12px;
    }

    .support-item__text {
        font-size: 10px;
        line-height: 1.45;
    }

    .support-item__photo {
        display: none;
    }

    .support-item:first-child .support-item__photo {
        position: absolute;
        right: 10px;
        top: 44px;
        display: block;
        width: 180px;
        height: 104px;
    }

    .voices .swiper-wrapper {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 8px;
        transform: none;
    }

    .voices .swiper-slide {
        width: auto;
    }

    .voice-card {
        grid-template-columns: 72px 1fr;
        gap: 10px;
        min-height: 126px;
        padding: 12px;
    }

    .voice-card__photo {
        width: 70px;
        height: 70px;
        border-radius: 14px;
    }

    .voice-card__title {
        margin-bottom: 4px;
        font-size: 12px;
    }

    .voice-card__text {
        margin-bottom: 5px;
        font-size: 10px;
        line-height: 1.5;
    }

    .voices__pagination {
        display: none;
    }

    .pricing__grid {
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 8px;
    }

    .price-card,
    .included-box {
        min-height: 154px;
        padding: 12px 10px 8px;
    }

    .price-card__name {
        font-size: 14px;
    }

    .price-card__catch,
    .price-card__detail,
    .price-card__features li {
        font-size: 9px;
    }

    .price-card__price strong {
        font-size: 27px;
    }

    .price-card__price span {
        font-size: 12px;
    }

    .price-card__per {
        padding: 1px 7px;
        font-size: 9px;
    }

    .included-box__title {
        font-size: 12px;
    }

    .included-box__list {
        gap: 7px;
    }

    .included-box__list li {
        gap: 6px;
        font-size: 10px;
    }

    .faq__layout {
        grid-template-columns: 1fr;
    }

    .faq__helper {
        display: none;
    }

    .campaign {
        order: 9;
        min-height: 164px;
        padding: 18px 20px 14px;
        background:
            linear-gradient(90deg, rgba(255, 255, 255, 0.22) 0%, rgba(255, 255, 255, 0.92) 38%, rgba(255, 255, 255, 0.98) 100%),
            #fff;
    }

    .campaign__image {
        inset: 0 auto 0 0;
        width: 34%;
        opacity: 1;
        -webkit-mask-image: linear-gradient(to right, #000 0%, #000 70%, transparent 100%);
        mask-image: linear-gradient(to right, #000 0%, #000 70%, transparent 100%);
    }

    .campaign__content {
        width: 70%;
        margin-left: auto;
    }

    .campaign__title {
        margin-bottom: 10px;
        font-size: 22px;
    }

    .campaign__points {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 8px;
        font-size: 9px;
    }

    .campaign__points li {
        justify-content: center;
        gap: 6px;
        line-height: 1.35;
        white-space: normal;
    }

    .campaign__points li::before {
        width: 18px;
        height: 18px;
        border-width: 2px;
    }

    .campaign__button {
        min-width: 300px;
        min-height: 38px;
        font-size: 13px;
    }

    .footer__action {
        justify-items: end;
    }

    .footer__copy {
        font-size: 10px;
        line-height: 1.5;
    }

    .footer__nav {
        grid-template-columns: repeat(4, 1fr);
        gap: 8px;
    }

    .footer__group {
        font-size: 9px;
    }

    .footer__heading {
        font-size: 10px;
    }

    .footer__socials,
    .footer__button {
        display: none;
    }
}

@media (max-width: 640px) {
    body {
        font-size: 13px;
    }

    .page {
        padding-top: 8px;
    }

    .section-heading {
        gap: 10px;
        font-size: 19px;
    }

    .site-header__nav {
        display: none;
    }

    .site-header {
        gap: 8px;
        padding: 0 12px;
    }

    .site-header.is-menu-open .site-header__nav {
        display: grid;
        grid-template-columns: 1fr;
    }

    .site-header__actions {
        display: flex;
    }

    .site-header__trial {
        min-height: 28px;
        padding: 0 12px;
        font-size: 9px;
    }

    .hero {
        min-height: 0;
    }

    .hero__body {
        min-height: 246px;
        padding: 20px 16px 12px;
    }

    .hero__image {
        opacity: 1;
        width: 56%;
        height: 238px;
        inset: 8px -18px auto auto;
        object-position: 58% center;
        -webkit-mask-image: linear-gradient(to right, transparent 0%, transparent 24%, rgba(0, 0, 0, 0.82) 42%, #000 62%);
        mask-image: linear-gradient(to right, transparent 0%, transparent 24%, rgba(0, 0, 0, 0.82) 42%, #000 62%);
    }

    .hero__content {
        width: 66%;
        padding-left: 0;
    }

    .hero__eyebrow {
        justify-content: center;
        width: max-content;
        max-width: 100%;
        margin: 0 0 8px;
        padding: 4px 9px;
        font-size: 9px;
        white-space: nowrap;
    }

    .hero__title {
        margin-bottom: 7px;
        font-size: 31px;
        line-height: 1.12;
    }

    .hero__lead {
        width: min(280px, 100%);
        font-size: clamp(8px, 2.05vw, 9px);
        line-height: 1.5;
    }

    .hero__count {
        position: absolute;
        top: 142px;
        right: 12px;
        width: 68px;
        height: 68px;
        margin: 0;
    }

    .hero__count-label {
        margin-top: -4px;
        font-size: 8px;
    }

    .hero__count-number {
        font-size: 14px;
    }

    .hero__count-text {
        font-size: 11px;
    }

    .hero__bottom {
        display: grid;
        justify-items: center;
        margin-top: -8px;
        padding-top: 0;
        padding-right: 18px;
        padding-bottom: 18px;
        padding-left: 18px;
    }

    .hero__features {
        grid-template-columns: repeat(2, 1fr);
        width: calc(100% - 28px);
        margin: 16px 0 12px;
        border: 1px solid var(--color-border);
        border-radius: 14px;
    }

    .hero__cta-wrap {
        position: relative;
        left: auto;
        bottom: auto;
        width: 100%;
        margin: 0;
    }

    .hero__cta-note {
        display: block;
        width: 100%;
        margin-top: 16px;
        padding-left: 0;
        font-size: 12px;
        text-align: center;
    }

    .hero__limited {
        display: inline-flex;
        left: 18px;
        top: -8px;
        transform: rotate(-8deg);
    }

    .hero__feature + .hero__feature {
        border-left: 0;
        border-top: 0;
    }

    .hero__feature:nth-child(2n) {
        border-left: 1px solid #d6ecea;
    }

    .hero__feature:nth-child(n+3) {
        border-top: 1px solid #d6ecea;
    }

    .button--primary,
    .campaign__button,
    .footer__button {
        min-width: 0;
        width: 100%;
        padding-left: 22px;
        padding-right: 48px;
        font-size: 15px;
    }

    .reasons,
    .voices,
    .campaign,
    .concerns,
    .lesson-support,
    .pricing,
    .faq,
    .footer {
        padding-left: 14px;
        padding-right: 14px;
    }

    .concerns__grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .reasons__grid,
    .pricing__grid,
    .campaign__points,
    .footer {
        grid-template-columns: 1fr;
    }

    .concern-card__image {
        background-size: contain;
    }

    .reason-card {
        display: grid;
        grid-template-columns: 44px minmax(0, 1fr);
        gap: 4px 12px;
        align-items: center;
        padding: 14px 16px;
    }

    .reason-card .line-icon {
        grid-row: 1 / 3;
        float: none;
        width: 40px;
        height: 40px;
        margin: 0;
    }

    .reason-card__title {
        margin: 0;
        font-size: 14px;
    }

    .reason-card__text {
        grid-column: 2;
        clear: none;
        font-size: 12px;
        line-height: 1.55;
    }

    .lesson-card {
        align-content: start;
        min-height: 0;
        max-width: none;
        margin: 0;
    }

    .lesson-card:not(:last-child)::after {
        display: none;
    }

    .lesson-card__image {
        height: 172px;
        margin-top: 0;
        background-size: auto 238px;
    }

    .lesson-list {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 8px;
    }

    .lesson-card {
        aspect-ratio: 1 / 1;
        align-content: stretch;
        padding: 18px 8px 8px;
        overflow: hidden;
    }

    .lesson-card::before {
        left: 8px;
        top: 8px;
        width: 20px;
        height: 20px;
        font-size: 10px;
    }

    .lesson-card__title {
        display: grid;
        align-items: center;
        min-height: 30px;
        margin-bottom: 3px;
        padding-left: 16px;
        font-size: 11px;
        line-height: 1.25;
    }

    .lesson-card__image {
        height: clamp(58px, 20vw, 88px);
        margin: 0 0 3px;
        background-size: auto clamp(94px, 31vw, 132px);
    }

    .lesson-card__text {
        display: -webkit-box;
        overflow: hidden;
        font-size: 8px;
        line-height: 1.35;
        -webkit-box-orient: vertical;
        -webkit-line-clamp: 3;
    }

    .lesson-support__support {
        min-height: 0;
        padding-right: 0;
    }

    .support-list {
        grid-template-columns: 1fr;
        gap: 12px;
    }

    .support-item {
        grid-template-columns: 36px minmax(0, 1fr) 86px;
        gap: 8px;
        align-items: start;
        min-height: 72px;
    }

    .support-item .line-icon {
        width: 34px;
        height: 34px;
        margin-top: 2px;
    }

    .support-item__photo,
    .support-item:first-child .support-item__photo {
        position: static;
        display: block;
        width: 86px;
        height: 64px;
    }

    .voices .swiper-wrapper {
        display: flex;
        gap: 0;
    }

    .voices__swiper {
        padding-bottom: 24px;
    }

    .voice-card {
        grid-template-columns: 112px 1fr;
        gap: 14px;
        min-height: 142px;
        margin-bottom: 0;
    }

    .voice-card__photo {
        width: 108px;
        height: 108px;
    }

    .voices__pagination {
        display: block;
        bottom: 2px;
    }

    .campaign {
        min-height: 0;
        padding-top: 18px;
        padding-bottom: 14px;
        background: #fff;
    }

    .campaign__content {
        width: 100%;
    }

    .campaign__image {
        display: none;
    }

    .campaign__points {
        width: min(330px, 100%);
        margin-right: auto;
        margin-bottom: 16px;
        margin-left: auto;
        gap: 8px;
        text-align: left;
    }

    .campaign__points li {
        display: grid;
        grid-template-columns: 24px minmax(0, 1fr);
        justify-content: start;
        gap: 10px;
        width: 100%;
        line-height: 1.45;
        white-space: normal;
    }

    .campaign__points li::before {
        width: 22px;
        height: 22px;
    }

    .price-card__price strong {
        font-size: 29px;
    }

    .price-card,
    .included-box {
        min-height: 0;
        padding: 14px 16px 14px;
    }

    .price-card__features {
        gap: 2px;
    }

    .pricing__grid {
        gap: 10px;
    }

    .footer {
        gap: 12px;
        padding: 16px 18px 18px;
    }

    .footer__action {
        display: none;
    }

    .footer__copy {
        width: 100%;
        margin-top: 8px;
        font-size: 11px;
        line-height: 1.55;
    }

    .footer__nav {
        grid-template-columns: repeat(2, 1fr);
        gap: 12px 22px;
        padding-top: 12px;
        border-top: 1px solid rgba(147, 220, 213, 0.55);
    }

    .footer__group {
        gap: 3px;
        font-size: 10px;
        line-height: 1.45;
    }

    .footer__heading {
        margin-bottom: 1px;
        color: var(--color-green-dark);
        font-size: 11px;
    }

    .footer__socials {
        display: none;
    }

    .faq__question {
        grid-template-columns: 24px 1fr 13px;
        align-items: start;
        border-radius: 18px;
    }

    .faq__item {
        border-radius: 18px;
    }

    .faq__answer {
        padding-right: 20px;
        padding-left: 42px;
    }
}
